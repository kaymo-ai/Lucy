# Copy to .env on the VM and fill in. .env is gitignored and must stay that way.
LUCY_ENV=production
LUCY_HOSTNAME=lucy.marcusfoster.com
POSTGRES_PASSWORD=
# The camp code, rotated per year. This is what members type to join.
# The server refuses to start in production if this is unset or still "test-code".
LUCY_JOIN_CODE=
# The codeword for the instructions page. Plain text -- it is checked by the
# API, not by Caddy, and it is a word forty people type into a web page rather
# than a credential. Changing it signs out every browser that had passed.
LUCY_SITE_CODE=
# The QA page at /admin. Its own secret: the camp codeword above goes to forty
# people and unlocks install instructions, while this shows every note in the
# camp and which install sent it. The server refuses to start without it.
LUCY_ADMIN_CODE=
