.DS_Store
*.pem

# Local env files
.env*.local
*.local.json

# Signing and release credentials. `.env*.local` did NOT cover .env.release,
# which holds the App Store Connect issuer and key IDs, and *.p8 is the private
# key that actually signs uploads -- neither belongs in the repository.
.env.release
*.p8

# IDE
.vscode/
*.swp
*~
.superpowers/


# Also match these when they are symlinks into another worktree — a trailing
# slash only matches real directories, so git happily stages the link itself.
scripts/output
scripts/models
scripts/.venv
backend/.venv
SnailsNative/vendor/llama.xcframework

# llama.cpp build artifacts (see SnailsNative/vendor/README.md)
SnailsNative/vendor/llama.xcframework/
SnailsNative/vendor/llama.cpp/build-apple/
SnailsNative/vendor/build-android/

# Render screenshots from render.sh verification sweeps — generated, disposable.
# Tracked images all live under Lucy/Assets.xcassets/, which this cannot match.
Lucy/*.png
Lucy/sweep/

# Spike: models and generated Xcode project
SnailsNative/spike/models/
SnailsNative/spike/MemorySpike/MemorySpike.xcodeproj/
SnailsNative/spike/.build/
SnailsNative/spike/spike-log.txt
Lucy/.build/
Lucy/Lucy.xcodeproj/
Lucy/Info.plist
Lucy/render-*.png
Lucy/soft-*.png
Lucy/dark-*.png
Lucy/fun-*.png
Lucy/speech*.png

# Xcode build output for the app (generated project + build dirs)
Lucy/.build-device/
# These two were missing, and `git add -A` swept them in: 460 MB of build
# output against 5 MB of actual project, including three 67 MB dSYMs and a
# signed IPA. Everything matching Lucy/.build* is generated and disposable.
Lucy/.build-check/
Lucy/.build-release/
*.xcarchive/
*.ipa
*.dSYM/
# Never again: the 192 MB knowledge database in three places is what made this
# repository unpushable for seven months. It lives in GCS, not in git.
ps_knowledge.db
Lucy/Lucy.xcodeproj/
.gstack/

# Backend service: secrets, virtualenv, and the VM's own data directories.
backend/.env
backend/.venv/
backend/media/
backend/pgdata/
backend/caddy_data/
backend/caddy_config/
backend/site/
output/enrich_cache.db

# Working copies of this repository, checked out inside it. Committing a
# worktree commits a second copy of the tree -- and the branch it holds is
# already in git by definition, so there is nothing here to preserve.
# `.claude/agents/` stays tracked; it is configuration the repo shares.
.claude/worktrees/

# Journal reports: generated from the phone, and they carry campmates'
# names and what the camp says about them. Local reading only.
lucy-journal*.html
# Gradle output from building the android branch on this machine; the
# sources live on that branch, the products belong to nobody.
android/.gradle/
android/build/
android/*/build/
android/local.properties
