<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Gemma 4 E2B holds ~3.6 GB resident. Without this an app sees roughly
         1.3 GB before jetsam kills it; the memory spike measured 6131 MB
         available with the entitlement live. -->
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>
</dict>
</plist>
